<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="4.0">
  <display-name>Library Coursework API</display-name>
  <servlet>
    <servlet-name>LibraryApiServlet</servlet-name>
    <servlet-class>ua.edu.nupp.library.web.LibraryApiServlet</servlet-class>
  </servlet>
  <servlet-mapping><servlet-name>LibraryApiServlet</servlet-name><url-pattern>/api/*</url-pattern></servlet-mapping>
  <welcome-file-list><welcome-file>index.html</welcome-file></welcome-file-list>
</web-app>
